APP_NAME=Lais
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webapp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Above the longest job's timeout (ProcessWhatsAppMessage, 150 s).
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production stores files on Cloudflare R2: PROOF_DISK=r2-private, MEDIA_DISK=r2-public.
PROOF_DISK=local
MEDIA_DISK=public
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"

# Asisten AI lewat 9Router (OpenAI-compatible)
LLM_DRIVER=gateway
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL_TEXT=ag/gemini-3.8-flash-low
LLM_TIMEOUT=40
LLM_MODEL_VISION=ag/gemini-3.8-flash-low
LLM_TIMEOUT_VISION=45

# The chat app the bot runs on: telegram (docs/TELEGRAM.md) or whatsapp (docs/WHATSAPP.md)
BOT_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# WhatsApp bot through GOWA (docs/WHATSAPP.md)
GOWA_URL=http://127.0.0.1:3000
GOWA_BASIC_AUTH=
GOWA_DEVICE_ID=lais
GOWA_WEBHOOK_SECRET=
GOWA_BOT_NUMBER=
GOWA_WEBHOOK_URL=http://host.docker.internal:8002/webhooks/gowa

# Password of the demo account judges sign in with (php artisan db:seed)
DEMO_PASSWORD=
